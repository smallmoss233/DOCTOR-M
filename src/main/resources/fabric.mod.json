{
	"schemaVersion": 1,
	"id": "doctor-m",
	"version": "${version}",
	"name": "DOCTOR M",
	"description": "AIT的扩展MOD,至于为啥叫DOCTOR M? 你别管 (An extension MOD of AIT. As for why it's called DOCTOR M? Don't worry about it.)",
	"authors": [
		"作者(Author):Small Moss",
        "贡献者(Contributor):白桦下的赤俄",
        "贡献者(Contributor):zhujianX_Offical",
        "贡献者(Contributor):斯格.尔特",
        "贡献者(Contributor):慢跑者"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/smallmoss233/doctor-m-template-1.20.1"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/doctor-m/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"doctor_m.DOCTORM"
		],
		"client": [
			"doctor_m.DOCTORMClient"
		],
		"fabric-datagen": [
			"doctor_m.DOCTORMDataGenerator"
		]
	},
	"mixins": [
		"doctor-m.mixins.json",
		{
			"config": "doctor-m.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
    },
  "suggests": {
    "ait": "*",
    "another-mod": "*"
  },
  "custom": {
    "resourcepack": {
      "ait_zh_cn": {
        "description": "DOCTOR M 中文汉化包 - BUG大冒险专属",
        "required": false,
        "version": 1
      }
    }
  }
}